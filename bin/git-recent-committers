#!/usr/bin/env bash

# Default number of days (overridden by GIT_RECENT_COMMITTERS_DAYS)
days="${GIT_RECENT_COMMITTERS_DAYS:-7}"

usage() {
  echo >&2 "usage: git recent-committers [-n <days>]"
  echo >&2 "  -n <days>  Use the last <days> days (default: GIT_RECENT_COMMITTERS_DAYS or 7)"
  exit 1
}

# Parse -n <days> option
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n)
      [[ $# -lt 2 ]] && { echo >&2 "error: -n requires a numeric argument."; usage; }
      days="$2"
      shift 2
      ;;
    -*)
      echo >&2 "error: unknown option $1"
      usage
      ;;
    *)
      break
      ;;
  esac
done

# Error: not inside a Git repository
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo >&2 "error: not a git repository (or any of the parent directories)."
  exit 1
fi

# Error: -n value must be a positive integer
if ! [[ "$days" =~ ^[1-9][0-9]*$ ]]; then
  echo >&2 "error: days must be a positive integer, got: $days"
  exit 1
fi

# Iterate over each line from git shortlog (commit count + committer name)
git shortlog -s -n HEAD --since="${days} days ago" | while read -r count name; do
  # name is everything after the leading whitespace and number
  echo "$count  $name"
done
